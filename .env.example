# 病历不归零·内测版
# 复制为 .env 后填写。.env 已被 Git 忽略，不要提交任何密钥。

APP_MODE=local_first
API_PORT=18768
FRONTEND_PORT=5173
# 只允许这个前端页面调用后端。正式部署改为真实前端 HTTPS 地址。
ALLOWED_ORIGIN=http://127.0.0.1:5173
APP_AI_MEDIA_MAX_BYTES=20971520

# 文字整理：当前建议使用 DeepSeek 的低价聊天模型。
MODEL_PROVIDER=deepseek
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_API_KEY=
MODEL_TIMEOUT_SECONDS=60
MODEL_MAX_TOKENS=4096

# 录音转写和照片识字：一把 AIHubMix Key。
MEDIA_RECOGNITION_PROVIDER=aihubmix
AIHUBMIX_API_KEY=
MEDIA_RECOGNITION_TIMEOUT_SECONDS=60

# 浏览器上传和函数请求的资源上限。
MEDIA_UPLOAD_MAX_BYTES=20971520
MEDIA_UPLOAD_PART_MAX_BYTES=2097152
MEDIA_UPLOAD_MAX_PARTS=12
MEDIA_REQUEST_MAX_BYTES=22020096

# 私有 TOS 密文备份。未创建资源前保持为空，页面会继续提供本地下载备份。
# 生产环境使用绑定到函数的最小权限 IAM 角色；平台会为每次请求注入短期 STS。
TOS_USE_VEFAAS_ROLE=true
# 仅本机联调可设为 false 并填写一组最小权限临时凭据；不能使用管理员密钥。
# TOS_ACCESS_KEY=
# TOS_SECRET_KEY=
# TOS_SECURITY_TOKEN=
TOS_REGION=cn-beijing
# 函数访问 TOS 使用同地域内网；浏览器短链接固定使用公网 HTTPS 地址。
TOS_ENDPOINT=https://tos-cn-beijing.ivolces.com
TOS_PUBLIC_ENDPOINT=https://tos-cn-beijing.volces.com
TOS_BUCKET=
TOS_BACKUP_PREFIX=backups/
# 短时上传/下载地址有效期，允许范围 60–900 秒。
TOS_GRANT_SECONDS=300

# 本地优先模式不使用 SQLite 保存健康资料。以下只为兼容旧测试工具。
# DB_PATH=runtime/records.sqlite3
# MEDIA_ROOT=runtime/media
