# Default: local mock, no external model request or token required.
MODEL_PROVIDER=mock
API_PORT=18768
MODEL_TIMEOUT_SECONDS=15
# Optional real provider: deepseek or modelscope. Never commit your .env.
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
MODELSCOPE_ACCESS_TOKEN=
MODELSCOPE_MODEL=
MODELSCOPE_BASE_URL=https://api-inference.modelscope.cn/v1
# Use a frontend dev proxy by default. Otherwise set the exact origin:
# ALLOWED_ORIGIN=http://localhost:5173
# DB_PATH=runtime/records.sqlite3

# Cloud ASR (explicit opt-in; P0 default remains local unless changed)
# qwen3-asr-flash is the recommended first candidate.
MEDIA_ASR_PROVIDER=dashscope
DASHSCOPE_API_KEY=
DASHSCOPE_ASR_MODEL=qwen3-asr-flash
# Optional regional or test endpoint override.
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
MEDIA_ASR_TIMEOUT_SECONDS=180
