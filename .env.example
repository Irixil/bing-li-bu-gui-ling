# Online demo configuration; copy to .env and fill your own credentials.
# For explicit offline regression: python -m scripts.start_demo --offline
MODEL_PROVIDER=openai_compatible
API_PORT=18768
# DeepSeek-V4-Pro-0813 has returned valid single requests with this 180 s
# deadline in the current integration evidence. A larger deadline does not
# make provider output deterministic or change the safety contract.
MODEL_TIMEOUT_SECONDS=180
MODEL_MAX_TOKENS=4096
# Optional real provider: deepseek or modelscope. Never commit your .env.
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
MODELSCOPE_ACCESS_TOKEN=
MODELSCOPE_MODEL=
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_MODEL=qwen3.8-flash
LLM_API_KEY=
MODELSCOPE_BASE_URL=https://api-inference.modelscope.cn/v1
# Universal OpenAI Chat Completions-compatible endpoint:
# MODEL_PROVIDER=openai_compatible
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
# Optional overrides for all real providers. Set only if the service supports them.
# DeepSeek defaults to JSON mode; ModelScope and generic default to false.
# LLM_JSON_MODE=false
# Example for ModelScope/Qwen non-thinking mode:
# LLM_EXTRA_BODY_JSON={"enable_thinking":false}
# Base URL includes its API version/path (e.g. https://relay.example/v1).
# A full https://relay.example/v1/chat/completions endpoint is also accepted.
# Use a frontend dev proxy by default. Otherwise set the exact origin:
# ALLOWED_ORIGIN=http://localhost:5173
# DB_PATH=runtime/records.sqlite3
# Cheapest one-key media setup: AIHubMix uses fixed documented endpoints and
# defaults to Gemini 2.5 Flash Lite audio understanding for Chinese ASR and
# qwen3.7-flash for OCR.
# Per-kind MEDIA_*_MODEL values remain optional overrides. Never commit the key.
MEDIA_RECOGNITION_PROVIDER=aihubmix
AIHUBMIX_API_KEY=
# MEDIA_ROOT=runtime/media
# Publicly documented operational guardrails, not product duration/pixel limits.
# Set all three to enable media writes; otherwise capabilities stay readable but
# every media write returns 503 media_limits_not_configured.
# MEDIA_UPLOAD_MAX_BYTES=134217728
# MEDIA_UPLOAD_PART_MAX_BYTES=8388608
# MEDIA_UPLOAD_MAX_PARTS=256
# Optional HTTP-body override for local testing; it does not enable media writes.
# MEDIA_REQUEST_MAX_BYTES=134217728

# Optional explicit overrides for the one-key AIHubMix route:
# MEDIA_ASR_MODEL=gemini-2.5-flash-lite
# MEDIA_OCR_MODEL=qwen3.7-flash
# Alternative providers remain supported through per-kind MEDIA_ASR_* and
# MEDIA_OCR_* URL/model/key settings; see docs/MODEL-CONNECTION.md.
MEDIA_RECOGNITION_TIMEOUT_SECONDS=60
